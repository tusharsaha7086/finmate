# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/finmate

# ── LLM Provider Configuration ───────────────────────────
# OpenAI / OpenAI-compatible API (e.g. SyneHQ proxy, Groq, Ollama, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_ID=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (Optional / Fallback)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.0-flash

# ── Twilio Configuration ──────────────────────────────────
# Twilio credentials for WhatsApp Sandbox or live WhatsApp sender
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+14155238886
